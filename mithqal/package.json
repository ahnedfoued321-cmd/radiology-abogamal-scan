{
  "name": "mithqal",
  "private": true,
  "version": "0.1.0",
  "description": "Mithqal — AI-native ERP & POS platform for Saudi Arabia (KSA first), Egypt and beyond",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @mithqal/api dev",
    "dev:web": "pnpm --filter @mithqal/web dev",
    "db:migrate": "pnpm --filter @mithqal/api migrate"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
