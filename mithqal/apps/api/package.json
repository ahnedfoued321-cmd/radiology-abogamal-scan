{
  "name": "@mithqal/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/jwt": "9.0.1",
    "@mithqal/domain": "workspace:*",
    "@mithqal/eta": "workspace:*",
    "@mithqal/money": "workspace:*",
    "@mithqal/zatca": "workspace:*",
    "bcryptjs": "2.4.3",
    "fastify": "5.1.0",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2"
  }
}
