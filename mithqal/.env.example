# Owner connection used for migrations and the e-invoice worker
MIGRATION_DATABASE_URL=postgres://mithqal:mithqal@localhost:5432/mithqal
# Runtime connection — non-superuser role created by migration 001 (RLS enforced)
DATABASE_URL=postgres://mithqal_app:mithqal_app@localhost:5432/mithqal
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# mock | sandbox | simulation | production
ZATCA_MODE=mock
ZATCA_CSID_TOKEN=
ZATCA_CSID_SECRET=
# Platform-operator API key (x-platform-key). Leave empty to disable.
PLATFORM_KEY=
